# ── Database & cache ─────────────────────────────────────────────
# Local: matches docker-compose. Production: Supabase session-pooler string / Render Key Value URL.
DATABASE_URL=postgres://alkeva:alkeva_local@localhost:5432/alkeva
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────
# Generate long random values for production (e.g. `openssl rand -hex 32`)
JWT_SECRET=dev-only-change-me
JWT_REFRESH_SECRET=dev-only-change-me-too
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=1209600

# ── Origins / ports ──────────────────────────────────────────────
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Fees (Decision A1 — all config, no hardcoded rates) ──────────
FEE_COMMISSION_PCT=2.0
FEE_SERVICE_CENTS=0
TAX_PCT=0
REFOREST_PCT=0

# ── Treasury (Decision A2 — demo-labeled placeholder values) ─────
TREASURY_FLOAT_ETB_CENTS=1000000000        # 10,000,000.00 ETB demo float
TREASURY_HALT_CENTS=150000000              # halt sell-backs below 1,500,000.00 ETB
SELLBACK_DAILY_CEILING_CENTS=500000000     # 5,000,000.00 ETB/day
VAULT_SEED_XAU_MG=5000000                  # 5,000 g demo vault gold
VAULT_SEED_XPT_MG=1000000                  # 1,000 g demo vault platinum

# ── Holding tiers (Decision A3 — bands in USD reference, stored ETB) ──
# Bands may also carry optional "perTxnCapCents" / "dailyCapCents" (string
# bigints, ETB cents); omitted = uncapped.
TIER_BANDS_JSON=[{"name":"Gold","maxUsd":1000},{"name":"Tanzanite","maxUsd":5000},{"name":"Ruby","maxUsd":15000},{"name":"Sapphire","maxUsd":30000},{"name":"Emerald","maxUsd":null}]

# ── Phase 2 demo ─────────────────────────────────────────────────
# Self-serve test money until Chapa deposits land (Phase 4) — then flip off.
DEMO_FAUCET_ENABLED=true
DEMO_FAUCET_MAX_CENTS=20000000             # 200,000.00 ETB max per faucet call
# Orders at/above this total route to compliance review instead of settling.
COMPLIANCE_REVIEW_THRESHOLD_CENTS=50000000 # 500,000.00 ETB (Q57)

# ── Price worker ─────────────────────────────────────────────────
PRICE_TICK_SECONDS=30
FX_CACHE_SECONDS=3600
PRICE_PRIMARY_URL=https://api.gold-api.com/price
PRICE_FALLBACK_URL=https://forex-data-feed.swissquote.com/public-quotes/bboquotes/instrument
FX_URL=https://open.er-api.com/v6/latest/USD

# ── Seed staff (local/demo only) ─────────────────────────────────
SEED_ADMIN_EMAIL=admin@alkeva.local
SEED_ADMIN_PASSWORD=change-me-on-first-login
# Compliance + finance are seeded only when BOTH halves of a pair are set —
# needed for the Phase 5 role-separation demo. Re-running the seed RESETS these
# accounts' passwords to whatever is here: staff have no self-serve reset, so
# the environment is the only way back in if a password is lost.
SEED_COMPLIANCE_EMAIL=compliance@alkeva.local
SEED_COMPLIANCE_PASSWORD=
SEED_FINANCE_EMAIL=finance@alkeva.local
SEED_FINANCE_PASSWORD=

# ── Chapa (Phase 4) ──────────────────────────────────────────────
# Test keys from dashboard.chapa.co (CHASECK_TEST-…). Empty = deposit and
# withdrawal endpoints answer 503 payments_unconfigured; everything else runs.
CHAPA_SECRET_KEY=
# The "secret hash" you set in Chapa dashboard → Webhooks. Same string here.
CHAPA_WEBHOOK_HASH=
CHAPA_API_BASE=https://api.chapa.co
DEPOSIT_MIN_CENTS=1000                     # 10.00 ETB
PAYOUT_MIN_CENTS=10000                     # 100.00 ETB
# Display-only per-channel caps (fact-check §6.5); Chapa enforces at checkout.
DEPOSIT_CHANNELS_JSON=[{"key":"telebirr","maxInCents":"7500000"},{"key":"cbebirr","maxInCents":"15000000","maxOutCents":"30000000"},{"key":"bank","maxInCents":"999999900"},{"key":"card","minInCents":"1000","maxInCents":"50000000"}]

# ── Gemini (Phase 5) ─────────────────────────────────────────────
# Empty = /ai/chat answers 503 ai_unconfigured. Demo: gemini-3.6-flash
# (best Amharic); rehearsal: gemini-3.5-flash-lite (spares the daily cap).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Email (Phase 5, optional) ────────────────────────────────────
# Any free SMTP (Brevo 300/day, or a Gmail app password). Unset = notification
# rows still recorded, delivery skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ALKEVA <no-reply@alkeva.local>
