{
  "name": "@alkeva/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "build": "tsc -p tsconfig.build.json && pnpm run bundle",
    "bundle": "esbuild dist/app.module.js --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node --import @swc-node/register/esm-register src/main.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:entry": "tsc -p tsconfig.entry.json"
  },
  "dependencies": {
    "@alkeva/db": "workspace:*",
    "@alkeva/risk": "workspace:*",
    "@alkeva/shared": "workspace:*",
    "@google/genai": "^2.16.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.38.3",
    "google-auth-library": "^11.0.2",
    "ioredis": "^5.4.2",
    "nodemailer": "^9.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.10.7",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.6",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3"
  }
}
