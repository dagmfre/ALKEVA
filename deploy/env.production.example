# ALKEVA — production environment for the netcup VPS (since Oct 2026).
#
# Copy to /opt/alkeva/.env on the VPS and `chmod 600` it. Every app container
# reads it via env_file; nothing is baked into the image. With
# NODE_ENV=production the API, worker and seed REFUSE TO START on unsafe
# values (packages/shared/src/env.ts::productionEnvProblems) — test keys,
# http origins, missing SMTP, Fayda enabled without credentials.
#
# Companion files (same directory, chmod 600):
#   postgres.env  POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
#   redis.env     REDIS_PASSWORD=<openssl rand -hex 24>   (then put it in REDIS_URL)
#   caddy.env     written by deploy/ship.sh from the two ALKEVA_* lines below
#   backup.env    BACKUP_AGE_RECIPIENT=age1…  BACKUP_RCLONE_REMOTE=remote:bucket
#
# Go-live procedure: docs/deploy/GO_LIVE.md.
# Filename note: not `.env.*` — the repo's blanket `.env*` ignore would eat it.

NODE_ENV=production

# ── Edge ─────────────────────────────────────────────────────────────────────
ALKEVA_DOMAIN=allkeva.com
ALKEVA_ACME_EMAIL=you@example.com

# ── Data (both on the private Docker network, never published) ───────────────
DATABASE_URL=postgresql://alkeva:PASSWORD@postgres:5432/alkeva?sslmode=disable
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379

# ── Origins ──────────────────────────────────────────────────────────────────
# https:// is what makes the auth cookies Secure — the boot guard insists.
WEB_ORIGIN=https://allkeva.com
API_PORT=4000

# ── Auth secrets: two DIFFERENT values, ≥32 chars: `openssl rand -base64 48` ──
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Sign-in methods and identity checks (Phase 10) ───────────────────────────
# A method is offered only when listed here AND configured below. Staff keep
# password sign-in even when "password" is removed for customers.
AUTH_METHODS=fayda,password
# Fayda is the identity check. Add ",document" only to re-open manual
# document upload + compliance review (e.g. for diaspora without Fayda).
KYC_METHODS=fayda
KYC_MIN_AGE=18
# After every staff member has enrolled a passkey: admin routes require a
# passkey-signed session.
STAFF_REQUIRE_PASSKEY=false

# ── Fayda (VeriFayda 2.0 / eSignet) — YOUR production partner client ─────────
# From partner.fayda.et → Partners → API Credentials / OIDC Client. The
# private key is the base64 of the RSA JWK whose public half is in the
# certificate you uploaded (GO_LIVE.md §4 — generate it locally, never on a
# website). Register the redirect URI exactly: https://allkeva.com/callback
FAYDA_ISSUER=https://esignet.ida.fayda.et
FAYDA_CLIENT_ID=
FAYDA_PRIVATE_KEY=
FAYDA_REDIRECT_URI=https://allkeva.com/callback
FAYDA_ACR_VALUES=mosip:idp:acr:generated-code mosip:idp:acr:biometrics
FAYDA_UI_LOCALES=en
# Only if your client is registered for encrypted userinfo (v1.8):
FAYDA_USERINFO_ENC_KEY=

# ── Passkeys ─────────────────────────────────────────────────────────────────
WEBAUTHN_RP_ID=allkeva.com
WEBAUTHN_ORIGIN=https://allkeva.com

# ── Google sign-in (only used if AUTH_METHODS lists google) ──────────────────
# Redirect URI in Cloud Console: https://allkeva.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Chapa — LIVE keys only (CHASECK_TEST is refused in production) ───────────
# Webhook URL in the Chapa dashboard: https://allkeva.com/api/webhooks/chapa
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_HASH=
# Staging only — lets NODE_ENV=production run on test keys. Never on the real box.
# ALLOW_SANDBOX_PAYMENTS=true

# ── Email — REQUIRED (verification codes, withdrawal codes, alerts) ──────────
# netcup blocks outbound 587/465 until its "Mail Block" policy is removed in
# the SCP (GO_LIVE.md §5).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ALKEVA <no-reply@allkeva.com>

# ── Browser notifications (Web Push) — `npx web-push generate-vapid-keys` ────
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@allkeva.com

# ── Gemini (AI assistant) — a key in the CLIENT's own Google Cloud project ───
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Seeds (the migrate container runs the seed on every `up`) ────────────────
# Production never seeds demo vault stock, a demo float or synthetic prices.
SEED_ADMIN_EMAIL=admin@allkeva.com
SEED_ADMIN_PASSWORD=
SEED_COMPLIANCE_EMAIL=
SEED_COMPLIANCE_PASSWORD=
SEED_FINANCE_EMAIL=
SEED_FINANCE_PASSWORD=

# ── Money limits — CONFIRM WITH THE CLIENT before launch ─────────────────────
FEE_COMMISSION_PCT=2.0
# Withdrawals below this go out instantly — only to a destination already paid
# before, in the Fayda legal name. Everything else waits for finance. 0 = all manual.
PAYOUT_AUTO_APPROVE_MAX_CENTS=1000000      # 10,000.00 ETB
PAYOUT_DAILY_MAX_CENTS=100000000           # 1,000,000.00 ETB per user per day
PAYOUT_DAILY_MAX_COUNT=5
COMPLIANCE_REVIEW_THRESHOLD_CENTS=50000000 # 500,000.00 ETB (single order OR day's total)
REVIEW_MAX_AGE_MIN=60
TREASURY_HALT_CENTS=150000000              # sell-backs halt below 1,500,000.00 ETB cash
SELLBACK_DAILY_CEILING_CENTS=500000000     # 5,000,000.00 ETB/day
# Dealer spread per side in basis points (0 = none; commission only).
QUOTE_SPREAD_BPS=0
# Price guard.
PRICE_MAX_TICK_MOVE_BPS=300
FX_MAX_MOVE_BPS=200
QUOTE_MAX_TICK_AGE_SEC=90

# ── Telegram Mini App + bot (Phase 11) — docs/deploy/TELEGRAM.md ───────────
# Add "telegram" to AUTH_METHODS to turn it on. The Mini App is its own host
# (Caddy serves it; only it may be framed by web.telegram.org). DNS: an A
# record for TELEGRAM_DOMAIN → this VPS. BotFather Main Mini App URL =
# TELEGRAM_WEBAPP_ORIGIN exactly (no redirect, origin protection ON).
TELEGRAM_DOMAIN=tg.allkeva.com
TELEGRAM_WEBAPP_ORIGIN=https://tg.allkeva.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINIAPP_SHORT_NAME=
# openssl rand -hex 32  (sent back by Telegram as X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INITDATA_MAX_AGE_SEC=300
TELEGRAM_SESSION_TTL_SEC=43200
TELEGRAM_SIGNUP_ENABLED=true
TELEGRAM_TEST_ENV=false
