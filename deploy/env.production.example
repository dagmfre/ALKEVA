# ALKEVA — production environment for the Google Compute Engine VM.
#
# Copy to /opt/alkeva/.env on the VM and `chmod 600` it. Every container reads
# it via env_file; nothing is baked into the image.
#
# Filename note: this file is `env.production.example`, not `.env.*`, because
# the repo's .gitignore ends with a blanket `.env*` rule that would swallow it.

# ── Edge ─────────────────────────────────────────────────────────────────────
# The domain must already resolve to the VM's static IP before first boot —
# Caddy solves an ACME HTTP-01 challenge on :80 and will retry noisily if not.
ALKEVA_DOMAIN=alkeva.example.com
ALKEVA_ACME_EMAIL=you@example.com

# ── Data ─────────────────────────────────────────────────────────────────────
# Supabase session-pooler string (port 5432, NOT the 6543 transaction pooler —
# createDb rejects it). Paste unquoted.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Redis now lives in this stack, on the private Docker network. No password
# needed and no port published — nothing outside the VM can reach it.
REDIS_URL=redis://redis:6379

# ── Origins ──────────────────────────────────────────────────────────────────
# WEB_ORIGIN drives CORS *and* the Secure flag on auth cookies
# (auth.controller.ts::cookieOpts). https:// here is what makes cookies Secure.
WEB_ORIGIN=https://alkeva.example.com
API_PORT=4000

# ── Auth secrets ─────────────────────────────────────────────────────────────
# Generate fresh, never reuse the Vercel ones: `openssl rand -base64 48`
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Passkeys ─────────────────────────────────────────────────────────────────
# RP_ID is the registrable domain, no scheme, no port. Unlike Vercel (where
# vercel.app sits on the Public Suffix List and forced the full subdomain), a
# domain you own can use the apex.
WEBAUTHN_RP_ID=alkeva.example.com
WEBAUTHN_ORIGIN=https://alkeva.example.com

# ── Google sign-in ───────────────────────────────────────────────────────────
# Authorised redirect URI in Cloud Console must be EXACTLY:
#   https://alkeva.example.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Chapa ────────────────────────────────────────────────────────────────────
# Webhook URL to register in the Chapa dashboard (note the /api prefix — Caddy
# strips it before the request reaches Nest):
#   https://alkeva.example.com/api/webhooks/chapa
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_HASH=

# ── Gemini ───────────────────────────────────────────────────────────────────
# MUST be a key created inside the client's own Google Cloud project, so its
# usage bills to the client's billing account and not to yours.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Email (Brevo / Gmail app password — see docs/deploy/email-setup.md) ──────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ALKEVA <no-reply@alkeva.example.com>

# ── Seeds ────────────────────────────────────────────────────────────────────
# The migrate container runs db:seed on every `up`. An empty admin password
# means the administrator is skipped entirely, with a loud log.
SEED_ADMIN_EMAIL=admin@alkeva.example.com
SEED_ADMIN_PASSWORD=
SEED_COMPLIANCE_EMAIL=
SEED_COMPLIANCE_PASSWORD=
SEED_FINANCE_EMAIL=
SEED_FINANCE_PASSWORD=

# ── Business config (see packages/shared/src/env.ts for every default) ───────
# Left at schema defaults unless the client has confirmed real numbers.
# FEE_COMMISSION_PCT=2.0
# TREASURY_FLOAT_ETB_CENTS=1000000000
# PAYOUT_AUTO_APPROVE_MAX_CENTS=50000000
DEMO_FAUCET_ENABLED=false
